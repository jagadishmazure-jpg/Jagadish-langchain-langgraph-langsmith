# Copy to .env only if you want real services. Nothing here is needed to run the repository.

# Model: scripted (default, offline) | azure | <provider>:<model>
LCSTACK_MODEL=scripted
# Azure OpenAI with an Entra ID token (az login or managed identity); no API key is used.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_VERSION=
# Optional real judge for the LLM-as-judge evaluator, e.g. azure
LCSTACK_JUDGE_MODEL=

# LangSmith: tracing is on only when BOTH are set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kestrel-support-desk
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Postgres checkpointer for scenario 15 (CI sets this for its service container)
DATABASE_URL=
