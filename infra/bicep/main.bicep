// Agent Server on Azure Container Apps with Postgres Flexible Server, Azure Cache for Redis,
// Key Vault (secrets incl. the LangSmith key) and a user-assigned managed identity.
// Mirrors infra/terraform. Never deployed from this repository (deploy.yml is gated off).
targetScope = 'resourceGroup'

@allowed(['dev', 'prod'])
param environment string
param location string = resourceGroup().location
param workload string = 'lcdesk'
@description('Agent Server image built with `langgraph build`')
param image string = 'mcr.microsoft.com/k8se/quickstart:latest'
@description('VNet-integrated environment with internal ingress, private Postgres and private endpoints')
param privateNetworking bool = false
@minValue(1)
@description('No scale-to-zero: the Agent Server runs background workers')
param minReplicas int = 1
param maxReplicas int = 3
param postgresSku string = 'Standard_B1ms'
param postgresTier string = 'Burstable'
@allowed(['Basic', 'Standard', 'Premium'])
param redisSku string = 'Basic'
@secure()
@description('Generated by the deploy script for each run; stored only in Key Vault')
param postgresAdminPassword string
param langsmithEndpoint string = 'https://api.smith.langchain.com'
param vnetAddressSpace string = '10.40.0.0/16'

var suffix = '${workload}-${environment}-${location}'
var compact = replace(suffix, '-', '')
var tags = {
  workload: workload
  environment: environment
  managed_by: 'bicep'
  repo: 'Jagadish-langchain-langgraph-langsmith'
}
var secretNames = ['database-uri', 'redis-uri', 'langsmith-api-key']
var roles = {
  acrPull: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')
  kvSecretsUser: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')
}

resource logs 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: 'log-${suffix}'
  location: location
  tags: tags
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
    workspaceCapping: { dailyQuotaGb: 1 }
  }
}

resource identity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'id-${suffix}-agentserver'
  location: location
  tags: tags
}

resource registry 'Microsoft.ContainerRegistry/registries@2023-07-01' = {
  name: take('cr${uniqueString(resourceGroup().id)}${compact}', 50)
  location: location
  tags: tags
  sku: { name: privateNetworking ? 'Premium' : 'Basic' }
  properties: {
    adminUserEnabled: false
    publicNetworkAccess: privateNetworking ? 'Disabled' : 'Enabled'
  }
}

resource acrPull 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: registry
  name: guid(registry.id, identity.id, 'acrpull')
  properties: {
    roleDefinitionId: roles.acrPull
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
  }
}

resource vault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: take('kv-${compact}', 24)
  location: location
  tags: tags
  properties: {
    tenantId: subscription().tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
    enablePurgeProtection: true
    softDeleteRetentionInDays: 90
    publicNetworkAccess: privateNetworking ? 'Disabled' : 'Enabled'
    networkAcls: {
      bypass: 'AzureServices'
      defaultAction: privateNetworking ? 'Deny' : 'Allow'
    }
  }
}

resource kvSecretsUser 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: vault
  name: guid(vault.id, identity.id, 'secretsuser')
  properties: {
    roleDefinitionId: roles.kvSecretsUser
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
  }
}

// ---------------------------------------------------------------- networking (optional)

resource vnet 'Microsoft.Network/virtualNetworks@2024-01-01' = if (privateNetworking) {
  name: 'vnet-${suffix}'
  location: location
  tags: tags
  properties: {
    addressSpace: { addressPrefixes: [vnetAddressSpace] }
    subnets: [
      {
        name: 'snet-apps'
        properties: {
          addressPrefix: cidrSubnet(vnetAddressSpace, 23, 0)
          networkSecurityGroup: { id: nsg[0].id }
        }
      }
      {
        name: 'snet-postgres'
        properties: {
          addressPrefix: cidrSubnet(vnetAddressSpace, 24, 4)
          networkSecurityGroup: { id: nsg[1].id }
          delegations: [{ name: 'postgres', properties: { serviceName: 'Microsoft.DBforPostgreSQL/flexibleServers' } }]
        }
      }
      {
        name: 'snet-endpoints'
        properties: {
          addressPrefix: cidrSubnet(vnetAddressSpace, 24, 5)
          networkSecurityGroup: { id: nsg[2].id }
        }
      }
    ]
  }
}

resource nsg 'Microsoft.Network/networkSecurityGroups@2024-01-01' = [for n in ['apps', 'postgres', 'endpoints']: if (privateNetworking) {
  name: 'nsg-${n}-${suffix}'
  location: location
  tags: tags
}]

resource pgDns 'Microsoft.Network/privateDnsZones@2020-06-01' = if (privateNetworking) {
  name: '${compact}.private.postgres.database.azure.com'
  location: 'global'
  tags: tags
}

resource pgDnsLink 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2020-06-01' = if (privateNetworking) {
  parent: pgDns
  name: 'postgres'
  location: 'global'
  properties: {
    registrationEnabled: false
    virtualNetwork: { id: vnet.id }
  }
}

// ---------------------------------------------------------------- Postgres and Redis

resource postgres 'Microsoft.DBforPostgreSQL/flexibleServers@2024-08-01' = {
  name: 'psql-${suffix}'
  location: location
  tags: tags
  sku: { name: postgresSku, tier: postgresTier }
  properties: {
    version: '16'
    administratorLogin: 'agentserver'
    administratorLoginPassword: postgresAdminPassword
    storage: { storageSizeGB: 32 }
    backup: {
      backupRetentionDays: environment == 'prod' ? 35 : 7
      geoRedundantBackup: environment == 'prod' ? 'Enabled' : 'Disabled'
    }
    authConfig: {
      activeDirectoryAuth: 'Enabled'
      passwordAuth: 'Enabled'
      tenantId: subscription().tenantId
    }
    network: privateNetworking ? {
      delegatedSubnetResourceId: '${vnet.id}/subnets/snet-postgres'
      privateDnsZoneArmResourceId: pgDns.id
      publicNetworkAccess: 'Disabled'
    } : {
      publicNetworkAccess: 'Disabled'
    }
  }
  dependsOn: [pgDnsLink]
}

resource pgTls 'Microsoft.DBforPostgreSQL/flexibleServers/configurations@2024-08-01' = {
  parent: postgres
  name: 'require_secure_transport'
  properties: { value: 'on', source: 'user-override' }
}

resource pgDb 'Microsoft.DBforPostgreSQL/flexibleServers/databases@2024-08-01' = {
  parent: postgres
  name: 'agentserver'
  properties: { charset: 'UTF8', collation: 'en_US.utf8' }
}

resource redis 'Microsoft.Cache/redis@2024-03-01' = {
  name: 'redis-${suffix}'
  location: location
  tags: tags
  properties: {
    sku: { name: redisSku, family: redisSku == 'Premium' ? 'P' : 'C', capacity: redisSku == 'Premium' ? 1 : 0 }
    enableNonSslPort: false
    minimumTlsVersion: '1.2'
    publicNetworkAccess: privateNetworking ? 'Disabled' : 'Enabled'
  }
}

resource pe 'Microsoft.Network/privateEndpoints@2024-01-01' = [for e in [
  { name: 'redis', id: redis.id, group: 'redisCache' }
  { name: 'vault', id: vault.id, group: 'vault' }
]: if (privateNetworking) {
  name: 'pe-${e.name}-${suffix}'
  location: location
  tags: tags
  properties: {
    subnet: { id: '${vnet.id}/subnets/snet-endpoints' }
    privateLinkServiceConnections: [{ name: e.name, properties: { privateLinkServiceId: e.id, groupIds: [e.group] } }]
  }
}]

resource dbUri 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: vault
  name: 'database-uri'
  properties: {
    contentType: 'postgres connection string'
    value: 'postgres://agentserver:${postgresAdminPassword}@${postgres.properties.fullyQualifiedDomainName}:5432/agentserver?sslmode=require'
  }
}

resource redisUri 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: vault
  name: 'redis-uri'
  properties: {
    contentType: 'redis connection string'
    value: 'rediss://:${redis.listKeys().primaryKey}@${redis.properties.hostName}:${redis.properties.sslPort}/0'
  }
}

// ---------------------------------------------------------------- Container Apps

resource env 'Microsoft.App/managedEnvironments@2024-03-01' = {
  name: 'cae-${suffix}'
  location: location
  tags: tags
  properties: {
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: {
        customerId: logs.properties.customerId
        sharedKey: logs.listKeys().primarySharedKey
      }
    }
    vnetConfiguration: privateNetworking ? {
      infrastructureSubnetId: '${vnet.id}/subnets/snet-apps'
      internal: true
    } : null
  }
}

resource app 'Microsoft.App/containerApps@2024-03-01' = {
  name: 'ca-${suffix}'
  location: location
  tags: tags
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: { '${identity.id}': {} }
  }
  properties: {
    managedEnvironmentId: env.id
    configuration: {
      activeRevisionsMode: 'Single'
      ingress: { external: !privateNetworking, targetPort: 8000, transport: 'http' }
      registries: [{ server: registry.properties.loginServer, identity: identity.id }]
      secrets: [for s in secretNames: {
        name: s
        keyVaultUrl: '${vault.properties.vaultUri}secrets/${s}'
        identity: identity.id
      }]
    }
    template: {
      scale: { minReplicas: minReplicas, maxReplicas: maxReplicas }
      containers: [
        {
          name: 'agent-server'
          image: image
          resources: { cpu: json('1.0'), memory: '2Gi' }
          env: [
            { name: 'DATABASE_URI', secretRef: 'database-uri' }
            { name: 'REDIS_URI', secretRef: 'redis-uri' }
            { name: 'LANGSMITH_API_KEY', secretRef: 'langsmith-api-key' }
            { name: 'LANGSMITH_ENDPOINT', value: langsmithEndpoint }
            { name: 'LANGSMITH_TRACING', value: 'true' }
            { name: 'AZURE_CLIENT_ID', value: identity.properties.clientId }
          ]
          probes: [
            { type: 'Liveness', httpGet: { path: '/ok', port: 8000 } }
            { type: 'Readiness', httpGet: { path: '/ok', port: 8000 } }
          ]
        }
      ]
    }
  }
  dependsOn: [kvSecretsUser, acrPull, dbUri, redisUri]
}

output AZURE_RESOURCE_GROUP string = resourceGroup().name
output containerAppName string = app.name
output agentServerFqdn string = app.properties.configuration.ingress.fqdn
output keyVaultName string = vault.name
